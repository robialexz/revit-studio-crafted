# Template de mediu — NOD BIM
# Nu pune valori reale aici; acest fișier e doar documentația contractului de env.
#
# Sursa de adevăr: ce citește codul (verificat):
#   - src/lib/site-config.ts          (VITE_* build-time)
#   - src/integrations/supabase/*.ts  (Supabase)
#   - src/lib/leads.server.ts         (Resend)

# ─────────────────────────────────────────────────────────────
# BUILD-TIME (client) — VITE_* sunt injectate în bundle-ul de browser.
# Se setează în mediul de build (local .env sau CI) INAINTE de `npm run deploy`.
# Nu sunt citite la runtime de Worker.
# ─────────────────────────────────────────────────────────────
VITE_SITE_URL="https://nodbim.com"
VITE_WHATSAPP_NUMBER="40750485793"
VITE_PUBLIC_EMAIL="contact@nodbim.com"
VITE_PHONE_NUMBER=""
VITE_GA_MEASUREMENT_ID=""

VITE_SUPABASE_URL="https://PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ─────────────────────────────────────────────────────────────
# RUNTIME (server) — citite din process.env de Worker-ul Cloudflare.
# Se configurează în Cloudflare → Workers & Pages → nodbim-com →
# Settings → Variables and Secrets. NU se pun în git și NU în VITE_*.
# ─────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL="https://PROJECT_ID.supabase.co"   # Variable (non-secret)
SUPABASE_SECRET_KEY="sb_secret_..."             # SECRET — preferat (format nou)
SUPABASE_SERVICE_ROLE_KEY=""                    # SECRET — fallback legacy, opțional
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."   # Variable — doar fallback SSR, opțional

# Notificare lead — Resend
RESEND_API_KEY="re_..."                         # SECRET
LEAD_NOTIFICATION_EMAIL="tu@gmail.com"          # Variable — destinatar notificări
LEAD_NOTIFICATION_FROM="NOD BIM <leads@nodbim.com>"  # Variable — expeditor (domeniu verificat în Resend)

# ─────────────────────────────────────────────────────────────
# Opțional build-time (doar pentru tooling CI)
# COMPATIBILITY_DATE="2026-07-01"  # scripts/patch-compat-date.mjs — default deja setat
# ─────────────────────────────────────────────────────────────
