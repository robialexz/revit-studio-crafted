# Public build-time configuration.
# VITE_* values are intentionally exposed to the browser bundle.
VITE_SITE_URL="https://nodbim.com"
VITE_WHATSAPP_NUMBER=""
VITE_PUBLIC_EMAIL=""
VITE_PHONE_NUMBER=""
VITE_GA_MEASUREMENT_ID=""

# Optional public advertising identifiers. They are documented for the future
# Google Ads integration; the current code does not send Google Ads events.
VITE_GOOGLE_ADS_CONVERSION_ID=""
VITE_GOOGLE_ADS_CONVERSION_LABEL=""

# Supabase public values used by the browser client.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Runtime/server configuration. Configure these in Cloudflare Workers
# Variables & Secrets; do not put secrets in wrangler.jsonc or Git.
SITE_URL="https://nodbim.com"
WHATSAPP_NUMBER=""
PUBLIC_EMAIL=""
GA_MEASUREMENT_ID=""
GOOGLE_ADS_CONVERSION_ID=""
GOOGLE_ADS_CONVERSION_LABEL=""

# Lead persistence and notification.
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
LEAD_NOTIFICATION_EMAIL=""
LEAD_NOTIFICATION_FROM=""
RESEND_API_KEY=""
# New-format Supabase secret key (sb_secret_...) — preferred for the server client.
SUPABASE_SECRET_KEY=""
# Legacy fallback used only when SUPABASE_SECRET_KEY is missing.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional database credentials/bindings reserved for a future database adapter.
# The current application uses Supabase and does not read DATABASE_URL.
DATABASE_URL=""
