# Template de mediu — NOD BIM (exemplu, NU copiați valori reale în git)
#
# Sursa de adevăr: ce citește codul (verificat):
#   - src/lib/site-config.ts          (VITE_* build-time)
#   - src/integrations/supabase/*.ts  (Supabase)
#   - src/lib/leads.server.ts         (Resend)

# ─────────────────────────────────────────────────────────────
# BUILD-TIME / PUBLIC (client)
# VITE_* sunt injectate în bundle-ul de browser la build.
# Se setează în mediul de build (local .env sau CI) INAINTE de deploy.
# Nu sunt citite la runtime de Worker. Nu puneți valori secrete aici.
# ─────────────────────────────────────────────────────────────
VITE_SITE_URL="https://example.com"
VITE_WHATSAPP_NUMBER="40700000000"
VITE_PUBLIC_EMAIL="contact@example.com"
VITE_PHONE_NUMBER=""
VITE_GA_MEASUREMENT_ID=""

VITE_SUPABASE_URL="https://PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Identitate legală / business (public build-time). Câmpurile necompletate
# NU se afișează public pe paginile legale.
VITE_LEGAL_NAME=""                     # ex: NOD BIM S.R.L.
VITE_LEGAL_FORM=""                     # ex: S.R.L. / P.F.A.
VITE_LEGAL_REGISTERED_ADDRESS=""       # sediu social
VITE_LEGAL_CUI=""                      # cod unic de identificare
VITE_LEGAL_REGISTRATION_NUMBER=""      # ex: J40/1234/2026
VITE_LEGAL_EMAIL=""                    # email oficial (dacă diferă de cel public)
VITE_LEGAL_PHONE=""                    # telefon oficial, format internațional

# ─────────────────────────────────────────────────────────────
# RUNTIME / SERVER
# Citite din process.env de Worker-ul Cloudflare.
# Se configurează în Cloudflare → Workers & Pages → nodbim-com →
# Settings → Variables and Secrets. Nu se pun în git și NU în VITE_*.
# ─────────────────────────────────────────────────────────────

# Supabase
SUPABASE_URL="https://PROJECT_ID.supabase.co"     # Variable (public)
SUPABASE_SECRET_KEY="sb_secret_..."               # SECRET — preferat (format nou)
SUPABASE_SERVICE_ROLE_KEY=""                      # SECRET — fallback legacy, opțional
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."     # Variable — doar fallback SSR, opțional

# Notificare lead — Resend
RESEND_API_KEY="re_..."                           # SECRET
LEAD_NOTIFICATION_EMAIL="owner@example.com"       # Variable — destinatar notificări
LEAD_NOTIFICATION_FROM="NOD BIM <leads@example.com>"  # Variable — expeditor de producție, OBLIGATORIU la runtime

# ─────────────────────────────────────────────────────────────
# Opțional build-time (doar pentru tooling CI)
# COMPATIBILITY_DATE="2026-07-01"  # scripts/patch-compat-date.mjs — default deja setat
# ─────────────────────────────────────────────────────────────
