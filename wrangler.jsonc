{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nodbim-com",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 7 * * *"]
  },
  "routes": [
    {
      "pattern": "nodbim.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nodbim.com",
      "custom_domain": true
    }
  ]
}
